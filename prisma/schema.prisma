// Nexie data model additions.
// Nexez currently uses Supabase directly at runtime; this Prisma schema mirrors
// the production tables in supabase/migrations/*_add_nexie_agent_tables.sql for
// teams that want generated types or future Prisma access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentChannel {
  TEXT
  VOICE
}

enum AgentThreadStatus {
  ACTIVE
  ARCHIVED
}

enum AgentMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AgentActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model UserAgent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @default("Nexie")
  persona     String   @default("personal_buyer_agent")
  voice       String   @default("warm_concise")
  preferences Json     @default("{}")
  memory      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  threads AgentThread[]

  @@unique([userId, name])
  @@index([userId])
  @@map("user_agents")
}

model AgentThread {
  id        String            @id @default(uuid()) @db.Uuid
  agentId   String            @map("agent_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  title     String            @default("New Nexie chat")
  channel   AgentChannel      @default(TEXT)
  status    AgentThreadStatus @default(ACTIVE)
  summary   String?
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent     UserAgent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  approvals AgentActionApproval[]

  @@index([userId, updatedAt])
  @@index([agentId, updatedAt])
  @@map("agent_threads")
}

model AgentMessage {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @map("thread_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      AgentMessageRole
  content   String
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId, createdAt])
  @@map("agent_messages")
}

model AgentActionApproval {
  id          String            @id @default(uuid()) @db.Uuid
  threadId    String            @map("thread_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  toolName    String            @map("tool_name")
  status      AgentActionStatus @default(PENDING)
  summary     String
  payload     Json
  result      Json?
  error       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt   DateTime?         @map("decided_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, status, createdAt])
  @@index([userId, status, createdAt])
  @@map("agent_action_approvals")
}
