{% comment %}
  Nexez Agent-Ready app embed.
  Server-renders same-origin discovery links and an optional verification meta
  into the storefront head. Shopify's signed App Proxy serves the live artifacts.
{% endcomment %}
{% assign nexez_proxy_path = block.settings.proxy_path | default: '/apps/nexez' | strip %}
<link rel="alternate" type="application/json" href="{{ nexez_proxy_path | append: '/agent.json' | escape }}" title="Nexez agent manifest">
<link rel="alternate" type="text/plain" href="{{ nexez_proxy_path | append: '/llms.txt' | escape }}" title="Nexez agent-readable summary">
{% if block.settings.token != blank %}
  <meta name="nexez-site-verification" content="{{ block.settings.token | escape }}">
{% endif %}

{% schema %}
{
  "name": "t:agent_ready.name",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "t:agent_ready.settings.proxy_path.label",
      "info": "t:agent_ready.settings.proxy_path.info",
      "default": "/apps/nexez"
    },
    {
      "type": "text",
      "id": "token",
      "label": "t:agent_ready.settings.token.label",
      "info": "t:agent_ready.settings.token.info"
    }
  ]
}
{% endschema %}
