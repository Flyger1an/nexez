{% comment %}
  Nexez Agent-Ready — app-embed block.
  Server-renders the Nexez manifest <link> (and optional verification meta) into
  the storefront <head> so AI agents that read the page discover the merchant's
  live Nexez agent manifest. The FULL JSON-LD + artifact redirects are delivered
  by the Nexez App Proxy (see the app's README) — a theme extension can't fetch
  embed.json at render or intercept /.well-known routes.
{% endcomment %}
{% if block.settings.slug != blank %}
  <link rel="alternate" type="application/json" href="https://nexez.app/{{ block.settings.slug | escape }}/agent.json" title="Agent manifest — Nexez">
  {% if block.settings.token != blank %}
    <meta name="nexez-site-verification" content="{{ block.settings.token | escape }}">
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Nexez Agent-Ready",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "slug",
      "label": "Nexez listing slug",
      "info": "From your listing URL: https://nexez.app/<slug>"
    },
    {
      "type": "text",
      "id": "token",
      "label": "Verification token (optional)",
      "info": "From Nexez → Settings → Your website. Lets Nexez verify your store."
    }
  ]
}
{% endschema %}
