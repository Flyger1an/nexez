{
  "name": "@nexez/agent-sdk",
  "version": "0.2.0",
  "description": "TypeScript client for Nexez agent discovery, checkout validation, and negotiation handoff.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
