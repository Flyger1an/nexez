# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/playwright/.auth/
/release-certification.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Supabase CLI metadata
supabase/.temp/

# local OpenClaw plugin inspection output
plugins/openclaw-nexez/reports/

# generated SDK builds
sdk/typescript/dist/

# local Claude Code config (personal permission allowlist + launch settings)
.claude/

# local Codex CLI config (personal MCP server list)
.codex/

# Shopify app-store review walkthrough video (served its purpose; kept locally)
plugins/shopify-nexez/app-store-media/review/*.mp4

# scratch renders in the section-image sources
nexez-section-images/png/_test*.png

# Supabase CLI local branch state
supabase/.branches/
